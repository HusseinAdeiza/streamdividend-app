{
  "version": "0.1.0",
  "name": "streamdividend",
  "instructions": [
    {
      "name": "initialize",
      "docs": [
        "Step 1: create the vault PDA."
      ],
      "accounts": [
        {
          "name": "authority",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "vault",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "xstockMint",
          "isMut": false,
          "isSigner": false,
          "docs": [
            "Tokenized stock mint (Token-v3 or Token-2022)."
          ]
        },
        {
          "name": "dividendMint",
          "isMut": false,
          "isSigner": false,
          "docs": [
            "Dividend mint — USDC (Token-v3)."
          ]
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": []
    },
    {
      "name": "deposit",
      "accounts": [
        {
          "name": "user",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "vault",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userState",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userXstock",
          "isMut": true,
          "isSigner": false,
          "docs": [
            "User's xStock account (v3 or 2022, must match the vault's xstock mint)."
          ]
        },
        {
          "name": "vaultXstock",
          "isMut": true,
          "isSigner": false,
          "docs": [
            "Vault's xStock account (owned by the vault PDA)."
          ]
        },
        {
          "name": "xstockMint",
          "isMut": false,
          "isSigner": false,
          "docs": [
            "The xStock mint — must equal the vault's."
          ]
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "tokenProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        }
      ]
    },
    {
      "name": "withdraw",
      "accounts": [
        {
          "name": "user",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "vault",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userState",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userXstock",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "vaultXstock",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userDividend",
          "isMut": true,
          "isSigner": false,
          "docs": [
            "User's USDC account — receives accrued dividend on the way out."
          ]
        },
        {
          "name": "vaultDividend",
          "isMut": true,
          "isSigner": false,
          "docs": [
            "Vault's USDC pool account."
          ]
        },
        {
          "name": "xstockMint",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "tokenProgram",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "usdcTokenProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "shares",
          "type": "u64"
        }
      ]
    },
    {
      "name": "triggerDividend",
      "docs": [
        "Admin triggers a dividend: `amount` USDC is transferred into the vault",
        "pool and immediately accrues to all holders pro-rata (per-share",
        "accumulator). Holders claim at any time; claim is idempotent."
      ],
      "accounts": [
        {
          "name": "authority",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "vault",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "adminDividend",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "vaultDividend",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "tokenProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        }
      ]
    },
    {
      "name": "claimDividend",
      "docs": [
        "User claims accrued dividends in USDC."
      ],
      "accounts": [
        {
          "name": "user",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "vault",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userState",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userDividend",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "vaultDividend",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "tokenProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": []
    },
    {
      "name": "setRoute",
      "accounts": [
        {
          "name": "user",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "vault",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userState",
          "isMut": true,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "route",
          "type": {
            "defined": "RoutePreference"
          }
        }
      ]
    }
  ],
  "accounts": [
    {
      "name": "UserState",
      "docs": [
        "Per-user position inside the vault."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user",
            "type": "publicKey"
          },
          {
            "name": "vault",
            "type": "publicKey"
          },
          {
            "name": "shares",
            "type": "u64"
          },
          {
            "name": "lastDividendsPerShare",
            "type": "u128"
          },
          {
            "name": "route",
            "type": {
              "defined": "RoutePreference"
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Vault",
      "docs": [
        "The vault (single PDA per authority)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "type": "publicKey"
          },
          {
            "name": "xstockMint",
            "type": "publicKey"
          },
          {
            "name": "dividendMint",
            "type": "publicKey"
          },
          {
            "name": "totalShares",
            "type": "u64"
          },
          {
            "name": "totalXstock",
            "type": "u64"
          },
          {
            "name": "dividendPool",
            "type": "u64"
          },
          {
            "name": "totalDividendsDistributed",
            "type": "u64"
          },
          {
            "name": "dividendsPerShare",
            "type": "u128"
          },
          {
            "name": "lastDividendTs",
            "type": "i64"
          },
          {
            "name": "route",
            "type": {
              "defined": "RoutePreference"
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "RoutePreference",
      "docs": [
        "Where earned yield goes (auto-compound is a recorded preference for now)."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Stream"
          },
          {
            "name": "AutoCompound"
          }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "DepositEvent",
      "fields": [
        {
          "name": "user",
          "type": "publicKey",
          "index": false
        },
        {
          "name": "amount",
          "type": "u64",
          "index": false
        },
        {
          "name": "shares",
          "type": "u64",
          "index": false
        }
      ]
    },
    {
      "name": "WithdrawEvent",
      "fields": [
        {
          "name": "user",
          "type": "publicKey",
          "index": false
        },
        {
          "name": "shares",
          "type": "u64",
          "index": false
        },
        {
          "name": "xstockOut",
          "type": "u64",
          "index": false
        },
        {
          "name": "dividendPaid",
          "type": "u64",
          "index": false
        }
      ]
    },
    {
      "name": "DividendTriggered",
      "fields": [
        {
          "name": "amount",
          "type": "u64",
          "index": false
        },
        {
          "name": "perShare",
          "type": "u128",
          "index": false
        }
      ]
    },
    {
      "name": "DividendClaimed",
      "fields": [
        {
          "name": "user",
          "type": "publicKey",
          "index": false
        },
        {
          "name": "amount",
          "type": "u64",
          "index": false
        }
      ]
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "ZeroAmount",
      "msg": "Amount must be greater than zero"
    },
    {
      "code": 6001,
      "name": "ZeroShares",
      "msg": "Shares computed to zero for this deposit"
    },
    {
      "code": 6002,
      "name": "InsufficientShares",
      "msg": "Insufficient shares to withdraw"
    },
    {
      "code": 6003,
      "name": "NothingToClaim",
      "msg": "Nothing to claim"
    },
    {
      "code": 6004,
      "name": "Overflow",
      "msg": "Overflow"
    },
    {
      "code": 6005,
      "name": "Unauthorized",
      "msg": "Unauthorized"
    },
    {
      "code": 6006,
      "name": "NoShares",
      "msg": "No shares in vault"
    },
    {
      "code": 6007,
      "name": "InvalidTokenAccount",
      "msg": "Invalid token account"
    }
  ]
}